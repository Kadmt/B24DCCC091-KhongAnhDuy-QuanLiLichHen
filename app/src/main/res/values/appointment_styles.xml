<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="ApTitle">
        <item
            name="android:fontFamily">sans-serif-medium</item>
        <item
            name="android:textSize">28sp</item>
        <item
            name="android:textColor">@color/ap_text</item>
        <item
            name="android:letterSpacing">-0.025</item>
    </style>
    <style
        name="ApSection">
        <item
            name="android:fontFamily">sans-serif-medium</item>
        <item
            name="android:textSize">17sp</item>
        <item
            name="android:textColor">@color/ap_text</item>
    </style>
    <style
        name="ApBody">
        <item
            name="android:textSize">14sp</item>
        <item
            name="android:textColor">@color/ap_muted</item>
        <item
            name="android:lineSpacingExtra">4dp</item>
    </style>
    <style
        name="ApInput"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item
            name="boxCornerRadiusTopStart">14dp</item>
        <item
            name="boxCornerRadiusTopEnd">14dp</item>
        <item
            name="boxCornerRadiusBottomStart">14dp</item>
        <item
            name="boxCornerRadiusBottomEnd">14dp</item>
        <item
            name="boxBackgroundColor">@color/ap_surface</item>
        <item
            name="boxStrokeColor">@color/ap_primary</item>
        <item
            name="hintTextColor">@color/ap_primary</item>
    </style>
    <style
        name="ApButton"
        parent="Widget.Material3.Button">
        <item
            name="android:minHeight">56dp</item>
        <item
            name="android:textSize">15sp</item>
        <item
            name="android:textAllCaps">false</item>
        <item
            name="android:fontFamily">sans-serif-medium</item>
        <item
            name="cornerRadius">16dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="backgroundTint">@color/ap_primary</item>
        <item
            name="android:textColor">@color/ap_on_primary</item>
        <item
            name="iconTint">@color/ap_on_primary</item>
    </style>
    <style
        name="ApSecondaryButton"
        parent="ApButton">
        <item
            name="backgroundTint">@color/ap_surface</item>
        <item
            name="android:textColor">@color/ap_primary</item>
        <item
            name="strokeColor">@color/ap_border</item>
        <item
            name="strokeWidth">1dp</item>
        <item
            name="iconTint">@color/ap_primary</item>
    </style>
</resources>