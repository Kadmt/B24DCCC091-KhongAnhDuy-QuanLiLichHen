<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            style="@style/ApSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="24dp"
            android:orientation="vertical"
            android:background="@drawable/ap_hero">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ap_ic_calendar"
                app:tint="@color/ap_hero_muted"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_eyebrow"
                android:layout_marginTop="20dp"
                android:textColor="@color/ap_hero_muted"
                android:textSize="11sp"
                android:letterSpacing="0.14" />
            <TextView
                android:id="@+id/tvTitle"
                style="@style/ApTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@android:color/white" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/ap_card"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ap_ic_location"
                    app:tint="@color/ap_primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:background="@drawable/ap_icon_tile" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        style="@style/ApBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/location_detail_label"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/ApSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="@color/ap_border" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ap_ic_clock"
                    app:tint="@color/ap_primary"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:background="@drawable/ap_icon_tile" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">
                    <TextView
                        style="@style/ApBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/datetime_detail_label"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tvDateTime"
                        style="@style/ApSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/ap_card"
            android:layout_marginTop="16dp">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="17sp"
                android:textColor="@color/ap_text"
                android:text="@string/reminder_label"
                app:thumbTint="@color/ap_switch_thumb"
                app:trackTint="@color/ap_switch_track" />
            <TextView
                android:id="@+id/tvReminderStatus"
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/ApButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_button"
            app:icon="@drawable/ap_ic_back"
            app:iconGravity="textStart"
            android:layout_marginTop="24dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/ApSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/delete_appointment"
            android:textColor="@color/ap_danger"
            app:backgroundTint="@color/ap_danger_soft"
            app:strokeWidth="0dp" />
    </LinearLayout>
</ScrollView>