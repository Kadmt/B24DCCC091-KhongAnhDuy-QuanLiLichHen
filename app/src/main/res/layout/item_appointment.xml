<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="12dp"
    android:descendantFocusability="blocksDescendants">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:background="@drawable/ap_card"
        android:foreground="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ap_ic_calendar"
            app:tint="@color/ap_primary"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:background="@drawable/ap_icon_tile" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:id="@+id/tvItemTitle"
                style="@style/ApSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvItemLocation"
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvItemDateTime"
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="@color/ap_text" />
            <TextView
                android:id="@+id/tvItemReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:background="@drawable/ap_chip_on"
                android:textColor="@color/ap_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="11sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ap_ic_chevron"
            app:tint="@color/ap_primary"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</LinearLayout>