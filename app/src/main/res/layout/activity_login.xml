<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ap_ic_calendar"
                app:tint="@color/ap_primary"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:background="@drawable/ap_icon_tile" />
            <TextView
                style="@style/ApSection"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:padding="24dp"
            android:orientation="vertical"
            android:background="@drawable/ap_hero">
            <TextView
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/brand_eyebrow"
                android:textColor="@color/ap_hero_muted"
                android:textSize="11sp"
                android:letterSpacing="0.16" />
            <TextView
                style="@style/ApTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_headline"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/white"
                android:textSize="30sp" />
            <TextView
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:layout_marginTop="12dp"
                android:textColor="@color/ap_hero_muted" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/ap_card"
            android:layout_marginTop="20dp">
            <TextView
                style="@style/ApSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_welcome" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/ApInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/username_label"
                app:startIconDrawable="@drawable/ap_ic_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:textColor="@color/ap_text"
                    android:autofillHints="username"
                    android:imeOptions="actionNext" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/ApInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/password_label"
                app:startIconDrawable="@drawable/ap_ic_lock"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:singleLine="true"
                    android:inputType="textPassword"
                    android:textSize="16sp"
                    android:textColor="@color/ap_text"
                    android:autofillHints="password" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:id="@+id/tvError"
                style="@style/ApBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:background="@drawable/ap_error"
                android:text="@string/login_error"
                android:textColor="@color/ap_danger"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/ApButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_button"
                app:icon="@drawable/ap_ic_arrow"
                app:iconGravity="textStart"
                android:layout_marginTop="24dp" />
        </LinearLayout>
        <TextView
            style="@style/ApSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_heading"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textSize="13sp" />
        <TextView
            style="@style/ApBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_sample_account"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>