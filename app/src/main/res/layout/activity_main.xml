<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/ap_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ap_ic_calendar"
            app:tint="@color/ap_primary"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:background="@drawable/ap_icon_tile" />
        <TextView
            style="@style/ApSection"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/app_name" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/ap_hero">
        <TextView
            style="@style/ApTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textColor="@android:color/white" />
        <TextView
            style="@style/ApBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:layout_marginTop="6dp"
            android:textColor="@color/ap_hero_muted" />
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawablePadding="8dp"
            android:textColor="@android:color/white"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <TextView
        style="@style/ApSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/schedule_title"
        android:layout_marginTop="24dp" />
    <TextView
        style="@style/ApBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/list_hint"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:textSize="12sp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/lvAppointments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/tvEmpty"
            style="@style/ApBody"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_appointments"
            android:visibility="gone" />
    </FrameLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdd"
        style="@style/ApButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_appointment"
        app:icon="@drawable/ap_ic_add"
        app:iconGravity="textStart"
        android:layout_marginTop="12dp" />
</LinearLayout>